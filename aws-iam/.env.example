# Mentor — AWS connection settings. These are NOT secrets.
# Never put access keys, secret keys or passwords in this file: sign-in happens in your browser.
#
# Fill in the blanks, then run:
#   ./setup_aws.sh --check    sign in + validate every policy with AWS (creates nothing)
#   ./setup_aws.sh            create the KMS key, IAM roles and MentorDeveloper permission set

# 12-digit AWS account ID (console: top-right menu)
AWS_ACCOUNT_ID=

# IAM Identity Center > Settings > "AWS access portal URL", e.g. https://d-1234567890.awsapps.com/start
AWS_SSO_START_URL=

# Your Identity Center username (the user you created for yourself)
AWS_SSO_USERNAME=

# Region where you enabled IAM Identity Center
AWS_SSO_REGION=ap-south-1

# Name of the admin permission set assigned to you in Identity Center
AWS_SSO_ADMIN_ROLE=AdministratorAccess

# Region for all Mentor resources (Mumbai)
AWS_REGION=ap-south-1
