# Copy to .env (git ignores it) and fill in. Never commit real values.
# Local stand-in for AWS Secrets Manager until AWS access is ready.

# From @BotFather in Telegram
MENTOR_TELEGRAM_BOT_TOKEN=

# Mentor answers only this chat. Leave empty, message the bot once, and it replies with your ID.
MENTOR_TELEGRAM_ALLOWED_CHAT_ID=

# Optional: override the local database (default: the docker compose Postgres)
# MENTOR_DATABASE_URL=postgresql+psycopg://mentor:mentor-local-only@127.0.0.1:5432/mentor

# Notion internal integration secret (notion.so/profile/integrations)
MENTOR_NOTION_TOKEN=

# Google Cloud project ID for the always-on server (infra/gcp/)
MENTOR_GCP_PROJECT=

# Gemini API key for the Google Cloud server (from AI Studio, or infra/gcp/create-server.sh
# makes one). On a free-tier key Google may use prompts to improve its products; a key whose
# project has billing linked prevents that. The Mac uses Ollama unless
# MENTOR_MODELS_FILE=models.cloud.yaml.
MENTOR_GEMINI_API_KEY=

# Claude API key for the cloud server (platform.claude.com, Settings, API keys)
MENTOR_ANTHROPIC_API_KEY=

# Web search for Mentor: free key from https://app.tavily.com (1,000 searches a month, no card).
MENTOR_TAVILY_API_KEY=

# Optional: Semantic Scholar's paper summaries (TLDRs) without being rate-limited. Free key by
# email from https://www.semanticscholar.org/product/api#api-key-form
MENTOR_SEMANTIC_SCHOLAR_API_KEY=
